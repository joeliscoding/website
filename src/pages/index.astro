---
import Base from "@layouts/Base.astro";

import { Icon } from "astro-icon/components";

import SpinningFish from "@components/SpinningFish.astro";
import Window from "@components/Window.astro";
---

<Base title="joeliscoding" description="the larp side of life">
    <div class="flex flex-col w-full gap-16">
        <section id="intro">
            <img
                src="/assets/laptop-cat-boil.webp"
                id="laptop-cat"
                class="laptop-cat w-md float-right"
                alt="Cat in front of a laptop doodle"
            />

            <h1>hi, i'm joel!</h1>

            <p class="text-lg">
                i'm a computer science student from germany. i like open source
                software and music. you found my little corner of the web,
                thanks for stopping by :)
            </p>
        </section>

        <section id="socials">
            <h2>socials</h2>
            <div id="social-links" class="grid grid-cols-4">
                <span class="flex">
                    <a href="mailto:hi@joeliscod.ing" class="flex items-center">
                        <Icon name="mail" class="inline mr-3 size-5" />
                        <span class="flex flex-col">
                            <span class="text-lg"> e-mail </span>
                            <span class="secondary-text text-sm">
                                hi@joeliscod.ing
                            </span>
                        </span>
                    </a>
                </span>
                <span class="flex">
                    <a
                        href="https://github.com/joeliscoding"
                        class="flex items-center"
                    >
                        <Icon name="github" class="inline mr-3 size-5" />
                        <span class="flex flex-col">
                            <span class="text-lg"> github </span>
                            <span class="secondary-text text-sm">
                                @joeliscoding
                            </span>
                        </span>
                    </a>
                </span>
                <span class="flex">
                    <a
                        href="https://x.com/joeliscoding"
                        class="flex items-center"
                    >
                        <Icon name="x" class="inline mr-3 size-5" />
                        <span class="flex flex-col">
                            <span class="text-lg"> twitter </span>
                            <span class="secondary-text text-sm">
                                @joeliscoding
                            </span>
                        </span>
                    </a>
                </span>
                <span class="flex">
                    <a href="/pub.key" class="flex items-center">
                        <Icon name="key" class="inline mr-3 size-5" />
                        <span class="flex flex-col">
                            <span class="text-lg"> gpg key </span>
                            <span class="secondary-text text-sm">
                                40362489A1F8CD6E
                            </span>
                        </span>
                    </a>
                </span>
            </div>
        </section>

        <section id="fish" class="min-h-64">
            <Window title="fish.txt" class="h-64 aspect-4/3 right-10">
                <SpinningFish />
            </Window>
        </section>
    </div>
</Base>

<style lang="scss">
    .laptop-cat {
        image-rendering: pixelated;
        image-rendering: -moz-crisp-edges;
        image-rendering: crisp-edges;
        shape-outside: url("/assets/laptop-cat.png");
        shape-margin: 1em;
        margin-left: 1em;
        @media (max-width: 880px) {
            float: none;
            display: block;
            margin: 0 auto;
            margin-bottom: 2em;
        }
    }

    #social-links {
        @media (max-width: 1150px) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        @media (max-width: 600px) {
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }

        a {
            transition: opacity 0.1s ease-in-out;
            &:hover {
                opacity: var(--hover-opacity);
            }
        }
    }
</style>
