---
import Base from "@layouts/Base.astro";

import ProjectCard from "@components/ProjectCard.astro";
---

<Base
    title="projects | joeliscoding"
    description="A collection of my personal projects."
>
    <div class="flex flex-col w-full gap-16">
        <section id="intro">
            <h1>projects</h1>
            <p>things i've been working on</p>
        </section>
        <section id="projects" class="grid grid-cols-2 gap-16">
            <ProjectCard
                imgSrc="/assets/projects/website.webp"
                imgAlt="image of this website"
                title="my website"
                description="(you're looking at it)"
                href="https://github.com/joeliscoding/website"
            />
            <ProjectCard
                imgSrc="/assets/projects/placeholder.webp"
                imgAlt="placeholder image of an ESP32"
                title="awesome project"
                description="awesome description"
                href=""
            />
            <ProjectCard
                imgSrc="/assets/projects/placeholder.webp"
                imgAlt="placeholder image of an ESP32"
                title="awesome project"
                description="awesome description"
                href=""
            />
            <ProjectCard
                imgSrc="/assets/projects/placeholder.webp"
                imgAlt="placeholder image of an ESP32"
                title="awesome project"
                description="awesome description"
                href=""
            />
        </section>
    </div>
</Base>

<style>
    #projects {
        @media (max-width: 1150px) {
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }
    }
</style>
